/* 路线详情页 */
.detail-container {
  padding-bottom: 140rpx;
}

/* 顶部轮播 */
.detail-hero {
  position: relative;
  height: 500rpx;
}

.hero-swiper {
  height: 100%;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 60rpx 30rpx 30rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.hero-meta {
  display: flex;
  gap: 16rpx;
}

.hero-tag {
  background: rgba(255,255,255,0.2);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  backdrop-filter: blur(10rpx);
}

/* 可点击统计标签栏 */
.stats-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: #fff;
  margin: -30rpx 30rpx 20rpx;
  padding: 30rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.08);
  position: relative;
  z-index: 2;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.stat-item.clickable:active {
  background: rgba(26,95,42,0.08);
  transform: scale(0.95);
}

.stat-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--border);
}

/* 信息卡片 */
.info-card {
  margin-top: 0;
}

.info-desc {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 时间轴 */
.timeline {
  padding: 20rpx 0;
}

.timeline-day {
  margin-bottom: 40rpx;
}

.day-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.day-badge {
  background: var(--primary);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.day-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text);
}

.day-nodes {
  padding-left: 20rpx;
}

.node {
  display: flex;
  margin-bottom: 20rpx;
}

.node.skipped {
  opacity: 0.5;
}

.node.skipped .node-name {
  text-decoration: line-through;
  color: var(--text-light);
}

.node.postponed .node-time {
  color: var(--accent);
}

.node-time {
  width: 100rpx;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: bold;
  flex-shrink: 0;
  padding-top: 20rpx;
}

.node-content {
  flex: 1;
  position: relative;
  padding-left: 30rpx;
}

.node-line {
  position: absolute;
  left: 0;
  top: 30rpx;
  bottom: -40rpx;
  width: 2rpx;
  background: var(--border);
}

.node:last-child .node-line {
  display: none;
}

.node-card {
  background: #fafafa;
  border-radius: 16rpx;
  overflow: hidden;
}

.node-img {
  width: 100%;
  height: 200rpx;
}

.node-info {
  padding: 20rpx;
}

.node-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.node-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text);
}

.node-status {
  font-size: 22rpx;
  color: var(--danger);
  background: rgba(230,67,64,0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.node-status.postponed {
  color: #b8860b;
  background: rgba(232,185,35,0.15);
}

.node-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.node-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

/* 底部操作栏 */
.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 100;
}

.footer-price {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 24rpx;
  color: var(--text-light);
}

.price-num {
  font-size: 40rpx;
  color: var(--danger);
  font-weight: bold;
}

.footer-btn {
  padding: 20rpx 50rpx;
  font-size: 28rpx;
}

/* AI 悬浮球 */
.ai-float-btn {
  position: fixed;
  right: 30rpx;
  bottom: 160rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(26,95,42,0.3);
  z-index: 200;
  transition: all 0.3s;
}

.ai-float-btn.active {
  transform: scale(0);
  opacity: 0;
}

.ai-float-btn:active {
  transform: scale(0.9);
}

.ai-float-icon {
  font-size: 48rpx;
}

.ai-float-text {
  font-size: 20rpx;
  color: #fff;
  margin-top: 4rpx;
}

/* AI 对话面板 */
.ai-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 70vh;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 300;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
  display: flex;
  flex-direction: column;
}

.ai-panel.open {
  transform: translateY(0);
}

.ai-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border);
}

.ai-panel-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ai-avatar {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.ai-title-text {
  display: flex;
  flex-direction: column;
}

.ai-title-text text {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text);
}

.ai-subtitle {
  font-size: 24rpx !important;
  color: var(--text-light) !important;
  font-weight: normal !important;
}

.ai-close {
  font-size: 36rpx;
  color: var(--text-light);
  padding: 10rpx;
}

/* AI 消息区域 */
.ai-messages {
  flex: 1;
  padding: 20rpx 30rpx;
  background: #f8f9fa;
}

.ai-message {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.ai-message.user {
  flex-direction: row-reverse;
}

.ai-message.system {
  justify-content: center;
}

.ai-message.system .msg-bubble {
  background: rgba(26,95,42,0.08);
  color: var(--text-secondary);
  max-width: 90%;
}

.msg-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
  margin: 0 12rpx;
}

.msg-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.ai-message.assistant .msg-bubble {
  border-top-left-radius: 4rpx;
}

.ai-message.user .msg-bubble {
  background: var(--primary);
  color: #fff;
  border-top-right-radius: 4rpx;
}

.msg-bubble text {
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.msg-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.action-btn {
  background: rgba(26,95,42,0.1) !important;
  color: var(--primary) !important;
  font-size: 24rpx !important;
  padding: 10rpx 24rpx !important;
  border-radius: 24rpx !important;
  margin: 0 !important;
}

.action-btn::after {
  border: none !important;
}

/* AI 思考动画 */
.ai-thinking {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
}

.thinking-dot {
  font-size: 24rpx;
  color: var(--primary);
  animation: blink 1.4s infinite both;
}

.thinking-dot:nth-child(1) { animation-delay: 0s; }
.thinking-dot:nth-child(2) { animation-delay: 0.2s; }
.thinking-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

/* AI 输入区域 */
.ai-input-area {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid var(--border);
  background: #fff;
  gap: 16rpx;
}

.ai-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: var(--text);
}

.ai-send-btn {
  background: #ddd;
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  transition: all 0.3s;
}

.ai-send-btn.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
}

.ai-send-btn::after {
  border: none;
}

/* 遮罩层 */
.ai-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 250;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.ai-overlay.show {
  opacity: 1;
  visibility: visible;
}
