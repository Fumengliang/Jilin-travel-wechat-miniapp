<view class="detail-container">
  <!-- 顶部大图 -->
  <view class="detail-hero">
    <swiper class="hero-swiper" indicator-dots autoplay circular>
      <swiper-item wx:for="{{route.images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" class="hero-image"/>
      </swiper-item>
    </swiper>
    <view class="hero-overlay">
      <text class="hero-title">{{route.name}}</text>
      <view class="hero-meta">
        <text class="hero-tag">{{route.duration}}</text>
        <text class="hero-tag">{{route.theme}}</text>
      </view>
    </view>
  </view>

  <!-- 可点击统计标签 -->
  <view class="stats-bar">
    <view class="stat-item clickable" bindtap="showHotels">
      <text class="stat-icon">🏨</text>
      <text class="stat-num">{{route.hotels}}+</text>
      <text class="stat-label">住宿</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item clickable" bindtap="showFoods">
      <text class="stat-icon">🍜</text>
      <text class="stat-num">{{route.foodCount}}+</text>
      <text class="stat-label">美食</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item clickable" bindtap="showTransport">
      <text class="stat-icon">🚌</text>
      <text class="stat-num">{{route.transport}}</text>
      <text class="stat-label">交通</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item clickable" bindtap="showSpots">
      <text class="stat-icon">📍</text>
      <text class="stat-num">{{route.spots}}</text>
      <text class="stat-label">打卡景点</text>
    </view>
  </view>

  <!-- 路线信息 -->
  <view class="card info-card">
    <text class="info-desc">{{route.desc}}</text>
  </view>

  <!-- 行程节点 -->
  <view class="card">
    <view class="section-title">📅 行程安排</view>
    <view class="timeline">
      <view class="timeline-day" wx:for="{{currentSchedule}}" wx:for-item="day" wx:key="dayNum">
        <view class="day-header">
          <view class="day-badge">Day {{day.dayNum}}</view>
          <text class="day-title">{{day.title}}</text>
        </view>
        <view class="day-nodes">
          <view class="node {{node.skipped ? 'skipped' : ''}}" wx:for="{{day.nodes}}" wx:for-item="node" wx:key="time">
            <view class="node-time">{{node.time}}</view>
            <view class="node-content">
              <view class="node-line"></view>
              <view class="node-card">
                <image class="node-img" src="{{node.image}}" mode="aspectFill" lazy-load/>
                <view class="node-info">
                  <view class="node-name-row">
                    <text class="node-name">{{node.name}}</text>
                    <text class="node-status" wx:if="{{node.skipped}}">[已跳过]</text>
                  </view>
                  <text class="node-desc">{{node.desc}}</text>
                  <view class="node-tags">
                    <text class="tag" wx:for="{{node.tags}}" wx:key="*this">{{tag}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="detail-footer safe-bottom">
    <!-- <view class="footer-price">
      <text class="price-label">参考预算</text>
      <text class="price-num">{{route.price > 0 ? '¥' + route.price : '免费'}}</text>
    </view> -->
    <button class="btn-primary footer-btn" bindtap="addToItinerary">
      <text>📋 加入我的行程</text>
    </button>
  </view>

  <!-- AI 悬浮球 -->
  <view class="ai-float-btn {{aiPanelOpen ? 'active' : ''}}" bindtap="toggleAIPanel">
    <text class="ai-float-icon">🤖</text>
    <text class="ai-float-text" wx:if="{{!aiPanelOpen}}">AI助手</text>
  </view>

  <!-- ==========================
       🔥 彻底修复版 AI 面板
       输入框固定死！聊天区高度固定死！
       ========================== -->
  <view class="ai-panel {{aiPanelOpen ? 'open' : ''}}" style="position:fixed;bottom:0;left:0;right:0;height:85%;background:#fff;border-top-left-radius:20rpx;border-top-right-radius:20rpx;z-index:999;">
    
    <!-- 头部 -->
    <view class="ai-panel-header" style="padding:20rpx;border-bottom:1rpx solid #eee;">
      <view class="ai-panel-title" style="display:flex;align-items:center;gap:16rpx;">
        <text class="ai-avatar">🤖</text>
        <view>
          <text style="font-size:32rpx;font-weight:bold;">行程AI助手</text>
          <text style="font-size:24rpx;color:#999;display:block;">实时调整你的行程</text>
        </view>
      </view>
      <text class="ai-close" bindtap="toggleAIPanel" style="position:absolute;right:24rpx;top:24rpx;font-size:36rpx;">✕</text>
    </view>

    <!-- ✅ 聊天区域：写死高度 420px → 绝对能滑动、能看见！ -->
    <scroll-view class="ai-messages" scroll-y style="height:420px;padding:20rpx;">
      <view class="ai-message system">
        <view class="msg-bubble" style="background:#f5f5f5;padding:20rpx;border-radius:16rpx;">
          <text style="font-size:28rpx;">你好！我是你的行程AI助手。
• "推迟1小时"
• "我不想去XX景点"
• "把A换成B"
我会实时帮你调整行程！</text>
        </view>
      </view>

      <view class="ai-message {{item.role}}" style="display:flex;align-items:flex-start;margin:16rpx 0;" wx:for="{{messages}}" wx:key="index">
        <view class="msg-avatar" wx:if="{{item.role === 'assistant'}}">🤖</view>
        <view class="msg-bubble" style="background:#007aff;color:#fff;padding:20rpx;border-radius:16rpx;max-width:70%;">
          <text style="font-size:28rpx;">{{item.content}}</text>
        </view>
        <view class="msg-avatar" wx:if="{{item.role === 'user'}}">👤</view>
      </view>

      <view class="ai-thinking" wx:if="{{isAIThinking}}" style="padding:10rpx;font-size:24rpx;color:#999;">
        <text>思考中</text>
      </view>
    </scroll-view>

    <!-- ✅ 输入框：固定死在底部，不会跑、不会盖消息 -->
    <view class="ai-input-area" style="position:absolute;bottom:0;left:0;right:0;display:flex;align-items:center;padding:20rpx;background:#fff;border-top:1rpx solid #eee;">
      <input 
        class="ai-input" 
        placeholder="输入你的需求..."
        value="{{userInput}}"
        bindinput="onInputChange"
        confirm-type="send"
        bindconfirm="sendMessage"
        style="flex:1;height:80rpx;padding:0 20rpx;background:#f5f5f5;border-radius:40rpx;font-size:28rpx;"
      />
      <button class="ai-send-btn" bindtap="sendMessage" style="margin-left:16rpx;height:80rpx;padding:0 30rpx;background:#007aff;color:#fff;border-radius:40rpx;font-size:28rpx;">
        发送
      </button>
    </view>
  </view>

  <view class="ai-overlay {{aiPanelOpen ? 'show' : ''}}" style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:998;" bindtap="toggleAIPanel"></view>
</view>