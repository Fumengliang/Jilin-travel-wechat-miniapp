<view class="detail-container">
  <!-- 顶部大图 -->
  <view class="detail-hero">
    <swiper class="hero-swiper" indicator-dots autoplay circular>
      <swiper-item wx:for="{{route.images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" class="hero-image"/>
      </swiper-item>
    </swiper>
    <view class="hero-overlay">
      <text class="hero-title">{{route.name}}</text>
      <view class="hero-meta">
        <text class="hero-tag">{{route.duration}}</text>
        <text class="hero-tag">{{route.theme}}</text>
      </view>
    </view>
  </view>

  <!-- 可点击统计标签 -->
  <view class="stats-bar">
    <view class="stat-item clickable" bindtap="showHotels">
      <text class="stat-icon">🏨</text>
      <text class="stat-num">{{route.hotels}}+</text>
      <text class="stat-label">住宿</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item clickable" bindtap="showFoods">
      <text class="stat-icon">🍜</text>
      <text class="stat-num">{{route.foodCount}}+</text>
      <text class="stat-label">美食</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item clickable" bindtap="showTransport">
      <text class="stat-icon">🚌</text>
      <text class="stat-num">{{route.transport}}</text>
      <text class="stat-label">交通</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item clickable" bindtap="showSpots">
      <text class="stat-icon">📍</text>
      <text class="stat-num">{{route.spots}}</text>
      <text class="stat-label">打卡景点</text>
    </view>
  </view>

  <!-- 路线信息 -->
  <view class="card info-card">
    <text class="info-desc">{{route.desc}}</text>
  </view>

  <!-- 行程节点 -->
  <view class="card">
    <view class="section-title">📅 行程安排</view>
    <view class="timeline">
      <view class="timeline-day" wx:for="{{route.schedule}}" wx:for-item="day" wx:key="dayNum">
        <view class="day-header">
          <view class="day-badge">Day {{day.dayNum}}</view>
          <text class="day-title">{{day.title}}</text>
        </view>
        <view class="day-nodes">
          <view class="node {{node.skipped ? 'skipped' : ''}} {{node.postponed ? 'postponed' : ''}}" wx:for="{{day.nodes}}" wx:for-item="node" wx:key="time">
            <view class="node-time">{{node.time}}</view>
            <view class="node-content">
              <view class="node-line"></view>
              <view class="node-card">
                <image class="node-img" src="{{node.image}}" mode="aspectFill" lazy-load/>
                <view class="node-info">
                  <view class="node-name-row">
                    <text class="node-name">{{node.name}}</text>
                    <text class="node-status" wx:if="{{node.skipped}}">[已跳过]</text>
                    <text class="node-status postponed" wx:if="{{node.postponed}}">[已推迟]</text>
                  </view>
                  <text class="node-desc">{{node.desc}}</text>
                  <view class="node-tags">
                    <text class="tag" wx:for="{{node.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="detail-footer safe-bottom">
    <view class="footer-price">
      <text class="price-label">参考预算</text>
      <text class="price-num">{{route.price > 0 ? '¥' + route.price : '免费'}}</text>
    </view>
    <button class="btn-primary footer-btn" bindtap="addToItinerary">
      <text>📋 加入我的行程</text>
    </button>
  </view>

  <!-- AI 对话悬浮球 -->
  <view class="ai-float-btn {{aiPanelOpen ? 'active' : ''}}" bindtap="toggleAIPanel">
    <text class="ai-float-icon">🤖</text>
    <text class="ai-float-text" wx:if="{{!aiPanelOpen}}">AI助手</text>
  </view>

  <!-- AI 对话面板 -->
  <view class="ai-panel {{aiPanelOpen ? 'open' : ''}}">
    <view class="ai-panel-header">
      <view class="ai-panel-title">
        <text class="ai-avatar">🤖</text>
        <view class="ai-title-text">
          <text>行程AI助手</text>
          <text class="ai-subtitle">输入需求，智能调整行程</text>
        </view>
      </view>
      <text class="ai-close" bindtap="toggleAIPanel">✕</text>
    </view>

    <scroll-view class="ai-messages" scroll-y scroll-into-view="msg-{{messages.length-1}}">
      <view class="ai-message system" id="msg-0">
        <view class="msg-bubble">
          <text>你好！我是你的行程AI助手。你可以这样告诉我：
• "计划推迟一个小时"
• "我不想去天池"
• "增加一个温泉景点"
• "把Day2的滑雪改成观光"

我会实时帮你调整行程方案！</text>
        </view>
      </view>
      <view class="ai-message {{item.role}}" wx:for="{{messages}}" wx:key="index" id="msg-{{index+1}}">
        <view class="msg-avatar" wx:if="{{item.role === 'assistant'}}">🤖</view>
        <view class="msg-bubble">
          <text>{{item.content}}</text>
          <view class="msg-actions" wx:if="{{item.actions}}">
            <button class="action-btn" size="mini" wx:for="{{item.actions}}" wx:for-item="act" wx:key="*this" bindtap="applyAction" data-action="{{act}}">
              {{act.label}}
            </button>
          </view>
        </view>
        <view class="msg-avatar" wx:if="{{item.role === 'user'}}">👤</view>
      </view>
      <view class="ai-thinking" wx:if="{{isAIThinking}}">
        <text class="thinking-dot">●</text>
        <text class="thinking-dot">●</text>
        <text class="thinking-dot">●</text>
      </view>
    </scroll-view>

    <view class="ai-input-area">
      <input 
        class="ai-input" 
        placeholder="输入你的需求..."
        value="{{userInput}}"
        bindinput="onInputChange"
        confirm-type="send"
        bindconfirm="sendMessage"
      />
      <button class="ai-send-btn {{userInput ? 'active' : ''}}" bindtap="sendMessage">
        <text>发送</text>
      </button>
    </view>
  </view>

  <!-- 遮罩层 -->
  <view class="ai-overlay {{aiPanelOpen ? 'show' : ''}}" bindtap="toggleAIPanel"></view>
</view>
