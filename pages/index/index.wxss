/* 首页样式 */
.index-container {
  padding-bottom: 40rpx;
}

/* 顶部横幅 */
.hero-section {
  position: relative;
  height: 400rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1a5f2a 0%, #0d3d18 50%, #1a5f2a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-bg::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(232,185,35,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.hero-content {
  text-align: center;
  z-index: 1;
}

.hero-title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 8rpx;
  margin-bottom: 16rpx;
}

.hero-subtitle {
  display: block;
  font-size: 32rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 12rpx;
}

.hero-slogan {
  display: block;
  font-size: 28rpx;
  color: var(--accent);
  letter-spacing: 4rpx;
}

/* 搜索栏 */
.search-bar {
  margin: -40rpx 30rpx 30rpx;
  position: relative;
  z-index: 2;
}

.search-input {
  background: #fff;
  border-radius: 50rpx;
  padding: 24rpx 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.1);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  color: var(--text-light);
  font-size: 28rpx;
}

/* 功能网格 */
.features-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 10rpx 0;
}

.feature-item {
  width: 18%;
  text-align: center;
  padding: 20rpx 0;
}

.feature-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin: 0 auto 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.12);
}

.feature-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text);
  margin-bottom: 4rpx;
}

.feature-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-light);
}

/* 路线列表 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.more-link {
  color: var(--primary);
  font-size: 26rpx;
}

.route-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.route-item {
  display: flex;
  gap: 24rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 16rpx;
}

.route-img {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #eee;
}

.route-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.route-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text);
}

.route-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.route-meta {
  display: flex;
  gap: 12rpx;
}

/* 统计数据 */
.stats-card {
  background: linear-gradient(135deg, #fff, #f8faf8);
}

.stats-list {
  padding: 20rpx 0;
}

.stat-item {
  margin-bottom: 24rpx;
}

.stat-bar {
  height: 16rpx;
  background: #eee;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.stat-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 1s ease-out;
}

.stat-text {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.stat-num {
  font-weight: bold;
  color: var(--text);
}

.stats-source {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
}

/* 底部标语 */
.footer-slogan {
  text-align: center;
  padding: 60rpx 40rpx;
}

.footer-slogan text {
  display: block;
  font-size: 28rpx;
  color: var(--primary);
  line-height: 1.8;
  font-style: italic;
}
