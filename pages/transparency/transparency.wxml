<view class="transparency-container">
  <!-- 顶部横幅 -->
  <view class="trans-hero">
    <view class="hero-content">
      <text class="hero-icon">🛡️</text>
      <text class="hero-title">透明消费保障</text>
      <text class="hero-subtitle">明码标价 · 拒绝套路 · 消费兜底</text>
    </view>
  </view>

  <!-- 三大保障 -->
  <view class="guarantees">
    <view class="guarantee-card">
      <text class="guarantee-icon">📋</text>
      <text class="guarantee-title">明码标价</text>
      <text class="guarantee-desc">所有商品与服务价格公开透明，无隐形消费</text>
    </view>
    <view class="guarantee-card">
      <text class="guarantee-icon">⭐</text>
      <text class="guarantee-title">真实评价</text>
      <text class="guarantee-desc">人工+AI智能审核机制，严厉打击虚假好评</text>
    </view>
    <view class="guarantee-card">
      <text class="guarantee-icon">💰</text>
      <text class="guarantee-title">赔付基金</text>
      <text class="guarantee-desc">专属赔付基金，消费兜底，让你放心消费</text>
    </view>
  </view>

  <!-- 商家列表 -->
  <view class="card">
    <view class="section-title">🏪 认证诚信商家</view>
    <view class="merchant-list">
      <view class="merchant-item" wx:for="{{merchants}}" wx:key="id">
        <image class="merchant-img" src="{{item.logo}}" mode="aspectFill"/>
        <view class="merchant-info">
          <view class="merchant-header">
            <text class="merchant-name">{{item.name}}</text>
            <view class="merchant-badge">
              <text class="badge">{{item.score}}分</text>
            </view>
          </view>
          <text class="merchant-type">{{item.type}}</text>
          <view class="merchant-tags">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
          <view class="merchant-price">
            <text>人均 ¥{{item.avgPrice}}</text>
            <text class="price-transparent">✓ 价格透明</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 消费举报 -->
  <view class="card report-card">
    <view class="section-title">📢 消费维权</view>
    <view class="report-form">
      <view class="form-item">
        <text class="form-label">商家名称</text>
        <input class="form-input" placeholder="请输入商家名称" value="{{reportForm.merchant}}" bindinput="inputMerchant"/>
      </view>
      <view class="form-item">
        <text class="form-label">问题类型</text>
        <picker mode="selector" range="{{reportTypes}}" value="{{reportTypeIndex}}" bindchange="selectType">
          <view class="form-picker">
            {{reportTypes[reportTypeIndex]}}
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">问题描述</text>
        <textarea class="form-textarea" placeholder="请详细描述您遇到的问题..." value="{{reportForm.desc}}" bindinput="inputDesc"/>
      </view>
      <button class="btn-primary report-btn" bindtap="submitReport">提交举报</button>
    </view>
  </view>

  <!-- 赔付说明 -->
  <view class="card payout-card">
    <view class="section-title">💎 赔付基金说明</view>
    <view class="payout-content">
      <view class="payout-item">
        <text class="payout-num">¥50,000+</text>
        <text class="payout-label">基金总额</text>
      </view>
      <view class="payout-item">
        <text class="payout-num">100%</text>
        <text class="payout-label">核实赔付率</text>
      </view>
      <view class="payout-item">
        <text class="payout-num">24h</text>
        <text class="payout-label">响应时效</text>
      </view>
    </view>
    <text class="payout-desc">平台设立专项赔付基金，对于经核实的宰客、虚假宣传等行为，将全额赔付消费者损失，并永久下架违规商家。</text>
  </view>
</view>
