/* 透明保页面 */
.transparency-container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 顶部横幅 */
.trans-hero {
  background: linear-gradient(135deg, #1a5f2a, #0d3d18);
  padding: 60rpx 40rpx;
  text-align: center;
}

.hero-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

/* 三大保障 */
.guarantees {
  display: flex;
  padding: 30rpx 20rpx;
  gap: 16rpx;
}

.guarantee-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.guarantee-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.guarantee-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text);
  margin-bottom: 8rpx;
}

.guarantee-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

/* 商家列表 */
.merchant-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.merchant-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 16rpx;
}

.merchant-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.merchant-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.merchant-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.merchant-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text);
}

.merchant-badge {
  background: var(--accent);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.badge {
  font-size: 24rpx;
  color: #fff;
  font-weight: bold;
}

.merchant-type {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.merchant-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.merchant-price {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: var(--text);
}

.price-transparent {
  color: var(--success);
  font-size: 24rpx;
}

/* 举报表单 */
.report-card {
  margin: 20rpx;
}

.report-form {
  padding: 20rpx 0;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text);
  margin-bottom: 12rpx;
  font-weight: bold;
}

.form-input, .form-picker, .form-textarea {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--text);
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  color: var(--text-light);
}

.form-textarea {
  height: 200rpx;
  width: 100%;
  box-sizing: border-box;
}

.report-btn {
  width: 100%;
  margin-top: 20rpx;
}

/* 赔付说明 */
.payout-card {
  margin: 20rpx;
}

.payout-content {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border);
}

.payout-item {
  text-align: center;
}

.payout-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: var(--primary);
}

.payout-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.payout-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}
