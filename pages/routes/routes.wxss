/* 路线列表页 */
.routes-container {
  background: var(--bg);
  min-height: 100vh;
}

/* 筛选栏 */
.filter-bar {
  background: #fff;
  padding: 20rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid var(--border);
}

.filter-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: #f5f5f5;
  border-radius: 30rpx;
  transition: all 0.3s;
}

.filter-item.active {
  background: var(--primary);
  color: #fff;
  font-weight: bold;
}

/* 路线卡片 */
.routes-list {
  padding: 20rpx;
}

.route-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.route-image-wrap {
  position: relative;
  height: 360rpx;
}

.route-image {
  width: 100%;
  height: 100%;
}

.route-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.route-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 24rpx 20rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.6));
}

.route-theme {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.route-content {
  padding: 24rpx;
}

.route-title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text);
  margin-bottom: 12rpx;
}

.route-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.route-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.highlight {
  font-size: 24rpx;
  color: var(--primary);
  background: rgba(26,95,42,0.08);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.route-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.route-stats {
  display: flex;
  gap: 20rpx;
}

.stat {
  font-size: 24rpx;
  color: var(--text-light);
}

.route-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.route-price {
  font-size: 32rpx;
  color: var(--danger);
  font-weight: bold;
}

.btn-mini {
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  line-height: 1.5;
  margin: 0;
}

.btn-mini::after {
  border: none;
}

.load-more {
  text-align: center;
  padding: 40rpx;
  color: var(--text-light);
  font-size: 26rpx;
}
