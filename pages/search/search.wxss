/* 搜索页样式 */
.search-container {
  min-height: 100vh;
  background: var(--bg);
}

.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--border);
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: var(--text-light);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.clear-btn {
  font-size: 24rpx;
  color: var(--text-light);
  padding: 8rpx;
}

.cancel-btn {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* AI思考动画 */
.ai-thinking {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  background: linear-gradient(90deg, rgba(26,95,42,0.05), transparent);
}

.ai-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.ai-text {
  flex: 1;
}

.ai-text text {
  display: block;
  font-size: 30rpx;
  color: var(--text);
  font-weight: bold;
}

.ai-sub {
  font-size: 24rpx !important;
  color: var(--text-light) !important;
  font-weight: normal !important;
  margin-top: 8rpx;
}

/* 搜索结果 */
.search-results {
  padding: 20rpx 30rpx;
}

.result-header {
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.result-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.result-img {
  width: 100%;
  height: 320rpx;
  display: block;
}

.result-info {
  padding: 24rpx;
}

.result-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.result-name {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text);
}

.match-score {
  font-size: 24rpx;
  color: var(--primary);
  background: rgba(26,95,42,0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.result-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.result-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.result-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.result-duration {
  font-size: 24rpx;
  color: var(--text-light);
}

.result-price {
  font-size: 32rpx;
  color: var(--danger);
  font-weight: bold;
}

/* 热门搜索 */
.hot-search, .search-history {
  padding: 30rpx;
}

.hot-tags, .history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.hot-tag {
  padding: 12rpx 28rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--text);
  border: 1rpx solid var(--border);
}

.history-tag {
  padding: 12rpx 28rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.clear-history {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: var(--text);
  margin-bottom: 12rpx;
}

.empty-sub {
  display: block;
  font-size: 26rpx;
  color: var(--text-light);
}
